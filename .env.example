# WILOTECH — Variables de Entorno y Conexión Supabase

# URL de tu Proyecto Supabase (Ejemplo: https://xyzcompany.supabase.co)
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave de API de Supabase (Anon Key o Service Role Key)
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# (Opcional) URL de Conexión Directa a la Base de Datos PostgreSQL de Supabase
# Ejemplo: postgresql://postgres:TuPassword@db.tu-proyecto.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.TU_PROYECTO.supabase.co:5432/postgres

# Clave Secreta del Servidor (Generada automáticamente si no se provee)
FERNET_SECRET_KEY=
